                }
            },
            "responses": {
                "default": {
                    "description": "",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "tags": [
                "Master Platform Administration"
            ]
        }
    }
}
