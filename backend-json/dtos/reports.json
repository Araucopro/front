{
    "IncomeStatementExpenseDetailDto": {
        "type": "object",
        "properties": {
            "type": {
                "enum": [
                    "financial",
                    "operational",
                    "administrative"
                ],
                "type": "string",
                "description": "Tipo de gasto",
                "example": "administrative"
            },
            "total": {
                "type": "number",
                "description": "Total acumulado para este tipo de gasto en el mes",
                "example": 15000
            }
        },
        "required": [
            "type",
            "total"
        ]
    },
    "IncomeStatementMonthDto": {
        "type": "object",
        "properties": {
            "month": {
                "type": "number",
                "description": "Número de mes del 1 al 12",
                "example": 1
            },
            "label": {
                "type": "string",
                "description": "Nombre del mes",
                "example": "Enero"
            },
            "year": {
                "type": "number",
                "description": "Año del bucket mensual",
                "example": 2026
            },
            "salesIncome": {
                "type": "number",
                "description": "Ingresos por ventas pagadas",
                "example": 125000
            },
            "purchaseOrdersIncome": {
                "type": "number",
                "description": "Ingresos por purchase orders pagadas",
                "example": 42000
            },
            "expenses": {
                "type": "number",
                "description": "Egresos por gastos",
                "example": 35000
            },
            "expenseDetail": {
                "description": "Detalle de gastos del mes por tipo de gasto",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/IncomeStatementExpenseDetailDto"
                }
            },
            "net": {
                "type": "number",
                "description": "Resultado neto del mes",
                "example": 132000
            }
        },
        "required": [
            "month",
            "label",
            "year",
            "salesIncome",
            "purchaseOrdersIncome",
            "expenses",
            "expenseDetail",
            "net"
        ]
    },
    "IncomeStatementTotalsDto": {
        "type": "object",
        "properties": {
            "salesIncome": {
                "type": "number",
                "description": "Total acumulado de ventas pagadas",
                "example": 800000
            },
            "purchaseOrdersIncome": {
                "type": "number",
                "description": "Total acumulado de purchase orders pagadas",
                "example": 200000
            },
            "expenses": {
                "type": "number",
                "description": "Total acumulado de egresos",
                "example": 150000
            },
            "net": {
                "type": "number",
                "description": "Total neto acumulado",
                "example": 850000
            }
        },
        "required": [
            "salesIncome",
            "purchaseOrdersIncome",
            "expenses",
            "net"
        ]
    },
    "IncomeStatementDto": {
        "type": "object",
        "properties": {
            "year": {
                "type": "number",
                "description": "Año consultado",
                "example": 2026
            },
            "storeId": {
                "type": "string",
                "description": "ID de la tienda filtrada, si aplica",
                "example": "store-uuid"
            },
            "months": {
                "description": "Serie mensual con ceros para meses sin movimientos",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/IncomeStatementMonthDto"
                }
            },
            "totals": {
                "description": "Totales acumulados del período",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/IncomeStatementTotalsDto"
                    }
                ]
            }
        },
        "required": [
            "year",
            "months",
            "totals"
        ]
    },
    "ReportsSaleFilterDto": {
        "type": "object",
        "properties": {
            "storeId": {
                "type": "string",
                "description": "ID de la tienda para filtrar el reporte",
                "example": "store-uuid"
            },
            "from": {
                "type": "string",
                "description": "Fecha desde (inclusive) en formato ISO 8601. Ej: 2026-04-01T00:00:00Z"
            },
            "to": {
                "type": "string",
                "description": "Fecha hasta (exclusive) en formato ISO 8601. Ej: 2026-04-17T00:00:00Z"
            },
            "page": {
                "type": "number",
                "default": 1,
                "minimum": 1,
                "description": "Página (paginación)",
                "example": 1
            },
            "limit": {
                "type": "number",
                "default": 50,
                "minimum": 1,
                "description": "Tamaño de página",
                "example": 50
            }
        }
    }
}
